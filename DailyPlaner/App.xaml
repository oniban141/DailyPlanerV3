<Application x:Class="DailyPlaner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DailyPlaner.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:BooleanToTextDecorationConverter x:Key="BooleanToTextDecorationConverter"/>
            <converters:BooleanToStatusBadgeConverter x:Key="BooleanToStatusBadgeConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
