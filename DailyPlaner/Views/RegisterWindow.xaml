<Window x:Class="DailyPlaner.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyPlaner.Views"
        xmlns:viewModels="clr-namespace:DailyPlaner.ViewModels"
        mc:Ignorable="d"
        Title="Регистрация" Height="760" Width="440" WindowStartupLocation="CenterScreen" MinHeight="720">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DailyPlaner;component/Resourse/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource LightBackgroundBrush}">
        <Border Style="{StaticResource CardStyle}" Margin="20" Padding="0" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка карточки (серо-синяя полоса) -->
                <Border Grid.Row="0" Background="{DynamicResource SecondaryBrush}" CornerRadius="14,14,0,0" Padding="24,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource PrimaryBrush}">
                                <TextBlock Text="Д" Foreground="#FFFFFF" FontFamily="Segoe UI" FontSize="18"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Ежедневник" Foreground="#FFFFFF" FontFamily="Segoe UI"
                                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Создайте аккаунт" Foreground="#FFFFFF" FontFamily="Segoe UI"
                                   FontSize="20" FontWeight="Bold" Margin="0,14,0,0"/>
                        <TextBlock Text="Это займёт меньше минуты" Foreground="#C9D2E0"
                                   FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Форма -->
                <StackPanel Grid.Row="1" Margin="28,24,28,24">
                    <TextBlock Text="Имя пользователя" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="10" Margin="0,0,0,14">
                        <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WatermarkTextBoxStyle}" Tag="Введите имя пользователя"/>
                    </Border>

                    <TextBlock Text="Пароль" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="10" Margin="0,0,0,14">
                        <Grid>
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource BasePasswordBoxStyle}"
                                        PasswordChanged="PasswordBox_PasswordChanged"/>
                            <TextBlock x:Name="PasswordWatermark" Text="Введите пароль"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Подтвердите пароль" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="10" Margin="0,0,0,14">
                        <Grid>
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource BasePasswordBoxStyle}"
                                        PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                            <TextBlock x:Name="ConfirmPasswordWatermark" Text="Повторите пароль"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Email" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="10" Margin="0,0,0,14">
                        <TextBox Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WatermarkTextBoxStyle}" Tag="Введите email"/>
                    </Border>

                    <TextBlock Text="Пол" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="10" Margin="0,0,0,22">
                        <Grid>
                            <ComboBox x:Name="GenderComboBox" ItemsSource="{Binding Genders}" SelectedValue="{Binding SelectedGenderId, Mode=TwoWay}"
                                      SelectedValuePath="Id"
                                      Style="{StaticResource BaseComboBoxStyle}" Background="Transparent">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="GenderWatermark" Text="Выберите пол" IsHitTestVisible="False"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Отмена" Command="{Binding CancelCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="2" Content="Зарегистрироваться" Command="{Binding RegisterCommand}"
                                Style="{StaticResource BaseButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>