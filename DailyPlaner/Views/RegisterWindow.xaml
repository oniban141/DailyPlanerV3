<Window x:Class="DailyPlaner.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyPlaner.Views"
        xmlns:viewModels="clr-namespace:DailyPlaner.ViewModels"
        mc:Ignorable="d"
        Title="Register" Height="500" Width="400" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DailyPlaner;component/Resourse/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource LightBackgroundBrush}">
        <Border Style="{StaticResource CardStyle}" Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Register New Account" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0">
                    <TextBox Text="{Binding Username, Mode=TwoWay}" Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,0"/>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0">
                    <PasswordBox Password="{Binding Password, Mode=TwoWay}" Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,0"/>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0">
                    <PasswordBox Password="{Binding ConfirmPassword, Mode=TwoWay}" Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,0"/>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0">
                    <TextBox Text="{Binding Email, Mode=TwoWay}" Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,0"/>
                </Border>

                <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0">
                    <TextBox Text="{Binding FirstName, Mode=TwoWay}" Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,0"/>
                </Border>

                <Border Grid.Row="6" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0">
                    <TextBox Text="{Binding LastName, Mode=TwoWay}" Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,0"/>
                </Border>

                <Border Grid.Row="7" Style="{StaticResource CardStyle}" Margin="0,0,0,20" Padding="0">
                    <ComboBox ItemsSource="{Binding Genders}" SelectedValue="{Binding SelectedGenderId, Mode=TwoWay}" DisplayMemberPath="Name" SelectedValuePath="Id" Style="{StaticResource BaseComboBoxStyle}" Margin="0,0,0,0"/>
                </Border>

                <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0" Width="80"/>
                    <Button Content="Register" Command="{Binding RegisterCommand}" Style="{StaticResource BaseButtonStyle}" Width="80"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
