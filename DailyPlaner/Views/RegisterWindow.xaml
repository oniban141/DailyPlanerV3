<Window x:Class="DailyPlaner.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="760" Width="480" WindowStartupLocation="CenterScreen" MinHeight="720">
    <Grid>
        <StackPanel Margin="20" VerticalAlignment="Center">
            <TextBlock Text="Создайте аккаунт" FontWeight="Bold" Margin="0,0,0,16"/>
            <TextBlock Text="Имя пользователя" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
            <TextBlock Text="Пароль" Margin="0,0,0,4"/>
            <Grid>
                <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>
                <TextBlock x:Name="PasswordWatermark" Text="Введите пароль"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock Text="Подтвердите пароль" Margin="0,12,0,4"/>
            <Grid>
                <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                <TextBlock x:Name="ConfirmPasswordWatermark" Text="Повторите пароль"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock Text="Email" Margin="0,12,0,4"/>
            <TextBox Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
            <TextBlock Text="Пол" Margin="0,0,0,4"/>
            <Grid>
                <ComboBox x:Name="GenderComboBox" ItemsSource="{Binding Genders}" SelectedValue="{Binding SelectedGenderId, Mode=TwoWay}"
                          SelectedValuePath="Id">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="GenderWatermark" Text="Выберите пол" IsHitTestVisible="False"
                           VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Отмена" Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Grid.Column="2" Content="Зарегистрироваться" Command="{Binding RegisterCommand}"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
