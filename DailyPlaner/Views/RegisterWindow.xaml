<Window x:Class="DailyPlaner.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyPlaner.Views"
        xmlns:viewModels="clr-namespace:DailyPlaner.ViewModels"
        mc:Ignorable="d"
        Title="Регистрация" Height="550" Width="400" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DailyPlaner;component/Resourse/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource LightBackgroundBrush}">
        <Border Style="{StaticResource CardStyle}" Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Регистрация нового аккаунта" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center" Margin="0,0,0,20" TextWrapping="Wrap"/>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0">
                    <TextBox Text="{Binding Username, Mode=TwoWay}" Style="{StaticResource WatermarkTextBoxStyle}" Tag="Введите имя пользователя"/>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0">
                    <Grid>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource BasePasswordBoxStyle}" PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBlock x:Name="PasswordWatermark" Text="Введите пароль" Foreground="#FF9E9E9E" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0">
                    <Grid>
                        <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource BasePasswordBoxStyle}" PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                        <TextBlock x:Name="ConfirmPasswordWatermark" Text="Подтвердите пароль" Foreground="#FF9E9E9E" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0">
                    <TextBox Text="{Binding Email, Mode=TwoWay}" Style="{StaticResource WatermarkTextBoxStyle}" Tag="Введите email"/>
                </Border>

                <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0,0,0,20" Padding="0">
                    <ComboBox ItemsSource="{Binding Genders}" SelectedValue="{Binding SelectedGenderId, Mode=TwoWay}" DisplayMemberPath="Name" SelectedValuePath="Id" Style="{StaticResource BaseComboBoxStyle}" Margin="0,0,0,0"/>
                </Border>

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0" Width="90"/>
                    <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}" Style="{StaticResource BaseButtonStyle}" Width="140"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
