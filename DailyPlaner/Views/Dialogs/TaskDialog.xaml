<Window x:Class="DailyPlaner.Views.Dialogs.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача" Height="560" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Название" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" x:Name="TitleBox" Style="{StaticResource WatermarkTextBoxStyle}" Tag="  Введите название задачи"/>

        <TextBlock Grid.Row="2" Text="Описание" Style="{StaticResource MutedTextBlockStyle}" Margin="0,12,0,4"/>
        <TextBox Grid.Row="3" x:Name="DescriptionBox" Style="{StaticResource WatermarkTextBoxStyle}"
                 Tag="  Введите описание" TextWrapping="Wrap" AcceptsReturn="True" Height="70"
                 VerticalContentAlignment="Top"/>

        <TextBlock Grid.Row="4" Text="Срок выполнения" Style="{StaticResource MutedTextBlockStyle}" Margin="0,12,0,4"/>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DatePicker Grid.Column="0" x:Name="DueDatePicker" Style="{StaticResource BaseDatePickerStyle}"/>
            <ComboBox Grid.Column="2" x:Name="TimeComboBox" Style="{StaticResource BaseComboBoxStyle}"/>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="Приоритет" Style="{StaticResource MutedTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="PriorityComboBox" Style="{StaticResource BaseComboBoxStyle}" Width="160"
                      HorizontalAlignment="Left"/>
            <CheckBox x:Name="ReminderCheckBox" Content="Напоминание" FontFamily="Segoe UI" FontSize="14" Margin="24,0,0,0" VerticalAlignment="Center"
                      Checked="ReminderCheckBox_Changed" Unchecked="ReminderCheckBox_Changed"/>
        </StackPanel>

        <StackPanel Grid.Row="7" x:Name="ReminderPanel" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock Text="Напомнить за" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,0,4"/>
            <ComboBox x:Name="ReminderOffsetComboBox" Style="{StaticResource BaseComboBoxStyle}" Width="220"
                      HorizontalAlignment="Left" SelectionChanged="ReminderOffsetComboBox_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}"
                    Width="100" Margin="0,0,12,0"/>
            <Button Content="Сохранить" Click="Save_Click" Style="{StaticResource BaseButtonStyle}" Width="110"/>
        </StackPanel>
    </Grid>
</Window>
