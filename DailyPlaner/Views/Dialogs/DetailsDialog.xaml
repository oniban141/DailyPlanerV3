<Window x:Class="DailyPlaner.Views.Dialogs.DetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подробная информация" Height="560" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DailyPlaner;component/Resourse/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SecondaryBrush}" CornerRadius="0" Padding="24,20,24,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryBrush}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="KindIcon" Text="📋" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="KindLabel" Text="Задача" Foreground="#C9D2E0" FontFamily="Segoe UI" FontSize="12"/>
                    <TextBlock x:Name="TitleText" Text="Название" Foreground="#FFFFFF" FontFamily="Segoe UI"
                               FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource LightCardBrush}" Margin="20,16,20,16" Padding="20"
                CornerRadius="14" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Описание" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,0,4"/>
                <TextBlock x:Name="DescriptionText" Text="—" Style="{StaticResource BaseTextBlockStyle}"
                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                <TextBlock x:Name="TimeLabel" Text="Срок" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,0,4"/>
                <TextBlock x:Name="TimeText" Text="—" Style="{StaticResource BaseTextBlockStyle}" Margin="0,0,0,14"/>

                <TextBlock x:Name="ExtraLabel" Text="Приоритет" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,0,4"/>
                <TextBlock x:Name="ExtraText" Text="—" Style="{StaticResource BaseTextBlockStyle}" Margin="0,0,0,14"/>

                <TextBlock x:Name="StatusLabel" Text="Статус" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,0,4"/>
                <TextBlock x:Name="StatusText" Text="—" Style="{StaticResource BaseTextBlockStyle}"/>
            </StackPanel>
        </Border>

        <Button x:Name="CloseButton" Grid.Row="2" Content="Закрыть" Click="Close_Click"
                Style="{StaticResource BaseButtonStyle}" Width="120" HorizontalAlignment="Right" Margin="0,0,20,18"/>
    </Grid>
</Window>
