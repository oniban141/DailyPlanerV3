<Window x:Class="DailyPlaner.Views.Dialogs.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заметка" Height="460" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Название" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" x:Name="TitleBox" Style="{StaticResource WatermarkTextBoxStyle}" Tag=" Введите название заметки"/>

        <TextBlock Grid.Row="2" Text="Содержимое" Style="{StaticResource MutedTextBlockStyle}" Margin="0,12,0,4"/>
        <TextBox Grid.Row="3" x:Name="ContentBox" Style="{StaticResource WatermarkTextBoxStyle}"
                 Tag=" Введите текст заметки" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalContentAlignment="Top"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}"
                    Width="100" Margin="0,0,12,0"/>
            <Button Content="Сохранить" Click="Save_Click" Style="{StaticResource BaseButtonStyle}" Width="110"/>
        </StackPanel>
    </Grid>
</Window>
