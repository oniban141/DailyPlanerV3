<Window x:Class="DailyPlaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyPlaner"
        xmlns:viewModels="clr-namespace:DailyPlaner.ViewModels"
        mc:Ignorable="d"
        Title="Ежедневник" Height="768" Width="1280" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DailyPlaner;component/Resourse/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource LightBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="0">
            <StackPanel VerticalAlignment="Stretch">
                <TextBlock Text="Ежедневник" Style="{StaticResource PageTitleStyle}" Foreground="{StaticResource AccentBrush}" Margin="10" HorizontalAlignment="Center"/>
                
                <Button Content="Обзор" Style="{StaticResource BaseButtonStyle}" Margin="5" HorizontalAlignment="Stretch"/>
                <Button Content="Задачи" Style="{StaticResource BaseButtonStyle}" Margin="5" HorizontalAlignment="Stretch"/>
                <Button Content="События" Style="{StaticResource BaseButtonStyle}" Margin="5" HorizontalAlignment="Stretch"/>
                <Button Content="Заметки" Style="{StaticResource BaseButtonStyle}" Margin="5" HorizontalAlignment="Stretch"/>
                <Button Content="Календарь" Style="{StaticResource BaseButtonStyle}" Margin="5" HorizontalAlignment="Stretch"/>
                <Button Content="Аналитика" Style="{StaticResource BaseButtonStyle}" Margin="5" HorizontalAlignment="Stretch"/>
                
                <Border Margin="10,20,10,10" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Button Content="Сменить тему" Command="{Binding ToggleThemeCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="Выйти" Command="{Binding LogoutCommand}" Style="{StaticResource BaseButtonStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentUser.Username}" Style="{StaticResource PageTitleStyle}"/>
                </StackPanel>
            </Border>

            <!-- Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="0,0,0,0">
                        <TextBox Text="{Binding SearchText, Mode=TwoWay}" Style="{StaticResource WatermarkTextBoxStyle}" Tag="Поиск задач..." Width="200" Margin="0,0,0,0"/>
                    </Border>
                    <Button Content="Поиск" Command="{Binding SearchCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Очистить" Command="{Binding ClearSearchCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                    
                    <ComboBox ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" DisplayMemberPath="Name" Style="{StaticResource BaseComboBoxStyle}" Width="150" Margin="0,0,10,0"/>
                    
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Style="{StaticResource BaseDatePickerStyle}" Width="150" Margin="0,0,10,0"/>
                </StackPanel>
            </Border>

            <!-- Tabs -->
            <TabControl Grid.Row="2">
                <!-- Tasks Tab -->
                <TabItem Header="Задачи">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <Button Content="Добавить задачу" Command="{Binding AddTaskCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="Изменить задачу" Command="{Binding EditTaskCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="Удалить задачу" Command="{Binding DeleteTaskCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="Выполнено" Command="{Binding CompleteTaskCommand}" Style="{StaticResource BaseButtonStyle}"/>
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" Style="{StaticResource BaseListViewStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,5,0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource BaseTextBlockStyle}" Margin="0,5,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="Срок: " Style="{StaticResource BaseTextBlockStyle}"/>
                                                <TextBlock Text="{Binding DueDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource BaseTextBlockStyle}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="Приоритет: " Style="{StaticResource BaseTextBlockStyle}"/>
                                                <TextBlock Text="{Binding Priority}" Style="{StaticResource BaseTextBlockStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- Events Tab -->
                <TabItem Header="События">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <Button Content="Добавить событие" Command="{Binding AddEventCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="Изменить событие" Command="{Binding EditEventCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="Удалить событие" Command="{Binding DeleteEventCommand}" Style="{StaticResource BaseButtonStyle}"/>
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" Style="{StaticResource BaseListViewStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,5,0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource BaseTextBlockStyle}" Margin="0,5,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="Начало: " Style="{StaticResource BaseTextBlockStyle}"/>
                                                <TextBlock Text="{Binding StartDate, StringFormat=yyyy-MM-dd HH:mm}" Style="{StaticResource BaseTextBlockStyle}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="Конец: " Style="{StaticResource BaseTextBlockStyle}"/>
                                                <TextBlock Text="{Binding EndDate, StringFormat=yyyy-MM-dd HH:mm}" Style="{StaticResource BaseTextBlockStyle}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="Место: " Style="{StaticResource BaseTextBlockStyle}"/>
                                                <TextBlock Text="{Binding Location}" Style="{StaticResource BaseTextBlockStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- Notes Tab -->
                <TabItem Header="Заметки">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <Button Content="Добавить заметку" Command="{Binding AddNoteCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="Изменить заметку" Command="{Binding EditNoteCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="Удалить заметку" Command="{Binding DeleteNoteCommand}" Style="{StaticResource BaseButtonStyle}"/>
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" Style="{StaticResource BaseListViewStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,5,0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="{Binding Content}" Style="{StaticResource BaseTextBlockStyle}" Margin="0,5,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="Создано: " Style="{StaticResource BaseTextBlockStyle}"/>
                                                <TextBlock Text="{Binding CreatedDate, StringFormat=yyyy-MM-dd HH:mm}" Style="{StaticResource BaseTextBlockStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- Calendar Tab -->
                <TabItem Header="Календарь">
                    <Grid>
                        <Border Style="{StaticResource CardStyle}" Margin="20">
                            <Calendar HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                                      SelectedDate="{Binding SelectedDate, Mode=TwoWay}" 
                                      Background="{StaticResource LightCardBrush}" 
                                      BorderBrush="{StaticResource PrimaryBrush}" 
                                      BorderThickness="2"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Analytics Tab -->
                <TabItem Header="Аналитика">
                    <Grid>
                        <Border Style="{StaticResource CardStyle}" Margin="20">
                            <StackPanel>
                                <TextBlock Text="Аналитика продуктивности" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                <TextBlock Text="Всего задач: " Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding Tasks.Count}" Style="{StaticResource BaseTextBlockStyle}" Margin="0,0,0,20"/>
                                
                                <TextBlock Text="Выполнено задач: " Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding CompletedTasksCount}" Style="{StaticResource BaseTextBlockStyle}" Margin="0,0,0,20"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Export/Import Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Экспорт JSON" Command="{Binding ExportToJsonCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="Импорт JSON" Command="{Binding ImportFromJsonCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="Экспорт CSV" Command="{Binding ExportToCsvCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="Импорт CSV" Command="{Binding ImportFromCsvCommand}" Style="{StaticResource BaseButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
