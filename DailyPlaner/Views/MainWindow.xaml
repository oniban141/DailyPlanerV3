<Window x:Class="DailyPlaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ежедневник" Height="768" Width="1280" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Ежедневник" FontWeight="Bold" Margin="10"/>
            <Button x:Name="NavOverviewButton" Content="Обзор" Tag="OverviewPage" Click="SidebarNav_Click"/>
            <Button x:Name="NavCalendarButton" Content="Календарь" Tag="CalendarPage" Click="SidebarNav_Click"/>
            <Button x:Name="NavTasksButton" Content="Задачи" Tag="TasksPage" Click="SidebarNav_Click"/>
            <Button x:Name="NavEventsButton" Content="События" Tag="EventsPage" Click="SidebarNav_Click"/>
            <Button x:Name="NavNotesButton" Content="Заметки" Tag="NotesPage" Click="SidebarNav_Click"/>
            <Button x:Name="NavAdminButton" Content="Администрирование" Tag="AdminPage" Click="SidebarNav_Click" Visibility="Collapsed"/>
            <Button Content="Проверить напоминания" Command="{Binding TestNotificationCommand}"/>
            <CheckBox x:Name="AutoStartSidebarCheckBox" Content="Автозапуск"
                      Checked="AutoStartSidebar_Changed" Unchecked="AutoStartSidebar_Changed"/>
            <Button Content="Выйти" Command="{Binding LogoutCommand}"/>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Привет, "/>
                <TextBlock Text="{Binding CurrentUser.Username}"/>
                <TextBlock Text="!"/>
                <Button Content="Экспорт JSON" Command="{Binding ExportToJsonCommand}"/>
                <Button Content="Импорт JSON" Command="{Binding ImportFromJsonCommand}"/>
            </StackPanel>

            <DockPanel x:Name="ToolbarBorder" Grid.Row="1" Margin="0,10,0,10">
                <Button x:Name="ClearSearchButton" DockPanel.Dock="Right" Content="Сбросить" Command="{Binding ClearSearchCommand}"/>
                <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchTextBox_KeyDown"/>
            </DockPanel>

            <Grid x:Name="OverviewPage" Grid.Row="2" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Обзор" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="Всего задач: " Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Tasks.Count}" Margin="0,0,20,0"/>
                    <TextBlock Text="Выполнено задач: " Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding CompletedTasksCount}" Margin="0,0,20,0"/>
                    <TextBlock Text="Событий: " Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Events.Count}" Margin="0,0,20,0"/>
                    <TextBlock Text="Заметок: " Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Notes.Count}"/>
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Ближайшие события" FontWeight="Bold" Margin="0,10,0,6"/>
                    <ListView Grid.Row="1" ItemsSource="{Binding Events}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StartDate, StringFormat='dd.MM HH:mm'}"/>
                                        <TextBlock Text="{Binding Location}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <Grid x:Name="TasksPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Новая задача" Command="{Binding AddTaskCommand}"/>
                    <Button Content="Изменить" Command="{Binding EditTaskCommand}"/>
                    <Button Content="Удалить" Command="{Binding DeleteTaskCommand}" CommandParameter="{Binding SelectedItems, ElementName=TasksList}"/>
                    <Button Content="Выполнено" Command="{Binding CompleteTaskCommand}"/>
                </StackPanel>
                <ListView Grid.Row="1" x:Name="TasksList" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                          SelectionMode="Extended" MouseDoubleClick="TasksList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource BooleanToTextDecorationConverter}}"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DueDate, StringFormat=dd.MM.yyyy}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Priority}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding IsCompleted, Converter={StaticResource BooleanToStatusBadgeConverter}}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="EventsPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Новое событие" Command="{Binding AddEventCommand}"/>
                    <Button Content="Изменить" Command="{Binding EditEventCommand}"/>
                    <Button Content="Удалить" Command="{Binding DeleteEventCommand}" CommandParameter="{Binding SelectedItems, ElementName=EventsList}"/>
                    <Button Content="Завершить" Command="{Binding CompleteEventCommand}"/>
                </StackPanel>
                <ListView Grid.Row="1" x:Name="EventsList" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                          SelectionMode="Extended" MouseDoubleClick="EventsList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource BooleanToTextDecorationConverter}}"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StartDate, StringFormat='dd.MM HH:mm'}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding EndDate, StringFormat='dd.MM HH:mm'}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Location}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding IsCompleted, Converter={StaticResource BooleanToStatusBadgeConverter}}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="NotesPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Новая заметка" Command="{Binding AddNoteCommand}"/>
                    <Button Content="Изменить" Command="{Binding EditNoteCommand}"/>
                    <Button Content="Удалить" Command="{Binding DeleteNoteCommand}" CommandParameter="{Binding SelectedItems, ElementName=NotesList}"/>
                </StackPanel>
                <ListView Grid.Row="1" x:Name="NotesList" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}"
                          SelectionMode="Extended" MouseDoubleClick="NotesList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"/>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Создано: "/>
                                    <TextBlock Text="{Binding CreatedDate, StringFormat='dd.MM.yyyy HH:mm'}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="AdminPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding AdminStatsHeader}" FontWeight="Bold" Margin="0,10,0,10"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBox Text="{Binding AdminSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        <Button Content="Сбросить поиск" Click="AdminClearSearchButton_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <DatePicker x:Name="AdminSearchDatePicker" SelectedDate="{Binding AdminSearchDate, Mode=TwoWay}"
                                    Width="120" Opacity="0" IsHitTestVisible="False"/>
                        <Button x:Name="AdminCalendarToggleButton" Content="Дата" Click="AdminCalendarToggleButton_Click"
                                ToolTip="Выбрать дату регистрации"/>
                        <Button Content="Сбросить дату" Click="AdminClearDateButton_Click" ToolTip="Сбросить дату"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
                    <TextBlock Text="Пользователей: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding TotalUsers}" Margin="0,0,12,0"/>
                    <TextBlock Text="Задач: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding TotalTasks}" Margin="0,0,12,0"/>
                    <TextBlock Text="Событий: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding TotalEvents}" Margin="0,0,12,0"/>
                    <TextBlock Text="Заметок: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding TotalNotes}" Margin="0,0,12,0"/>
                    <TextBlock Text="Напоминаний: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding TotalReminders}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <Button Content="Сбросить пароль" Command="{Binding ResetUserPasswordCommand}"/>
                    <Button Content="Удалить пользователя" Command="{Binding DeleteUserCommand}"/>
                </StackPanel>
                <ListView Grid.Row="4" x:Name="AdminUsersList" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedAdminUser}"
                          SelectionMode="Single" MouseDoubleClick="AdminUsersList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Username}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Email}" Margin="0,0,12,0"/>
                                    <TextBlock Text="Регистрация: " Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="CalendarPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,10,16,10">
                    <TextBlock Text="Календарь" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Calendar x:Name="MainCalendar" SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                              SelectedDatesChanged="MainCalendar_SelectedDatesChanged"/>
                    <TextBlock Text="Все события на выбранный день" FontWeight="Bold" Margin="0,10,0,6"/>
                    <ListView x:Name="DayEventsList" MouseDoubleClick="DayItem_MouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StartDate, StringFormat='HH:mm'}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Title}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding SelectedDate, StringFormat='dddd, dd MMMM yyyy'}" FontWeight="Bold" Margin="0,10,0,6"/>
                    <ListView x:Name="DayTasksList" MouseDoubleClick="DayItem_MouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DueDate, StringFormat='HH:mm'}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Title}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
