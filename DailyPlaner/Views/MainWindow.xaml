<Window x:Class="DailyPlaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyPlaner"
        xmlns:viewModels="clr-namespace:DailyPlaner.ViewModels"
        mc:Ignorable="d"
        Title="Ежедневник" Height="768" Width="1280" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DailyPlaner;component/Resourse/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource LightBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Border Grid.Column="0" Background="{DynamicResource SecondaryBrush}"
                CornerRadius="0,24,24,0" Margin="0,12,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,20,24">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource PrimaryBrush}">
                        <Image x:Name="HeaderIcon" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="Ежедневник" Foreground="#FFFFFF" FontFamily="Segoe UI"
                               FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                
                <StackPanel Grid.Row="1">
                    <Button x:Name="NavOverviewButton" Content="🏠   Обзор" Style="{StaticResource SidebarActiveButtonStyle}" Tag="OverviewPage" Click="SidebarNav_Click"/>
                    <Button x:Name="NavCalendarButton" Content="🗓   Календарь" Style="{StaticResource SidebarButtonStyle}" Tag="CalendarPage" Click="SidebarNav_Click"/>
                    <Button x:Name="NavTasksButton" Content="📋   Задачи" Style="{StaticResource SidebarButtonStyle}" Tag="TasksPage" Click="SidebarNav_Click"/>
                    <Button x:Name="NavEventsButton" Content="📅   События" Style="{StaticResource SidebarButtonStyle}" Tag="EventsPage" Click="SidebarNav_Click"/>
                    <Button x:Name="NavNotesButton" Content="📝   Заметки" Style="{StaticResource SidebarButtonStyle}" Tag="NotesPage" Click="SidebarNav_Click"/>
                    <Button x:Name="NavAdminButton" Content="🛡   Администрирование" Style="{StaticResource SidebarButtonStyle}" Tag="AdminPage" Click="SidebarNav_Click" Visibility="Collapsed"/>

                    <Border Background="#5B6F92" Height="1" Margin="20,14,20,14" CornerRadius="1"/>

                    <Button Content="🙃   Сменить тему" Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="🔔   Проверить напоминания" Command="{Binding TestNotificationCommand}"
                            Style="{StaticResource SidebarButtonStyle}"/>
                    <CheckBox x:Name="AutoStartSidebarCheckBox" Content="🔁   Автозапуск"
                              Style="{StaticResource SidebarCheckBoxStyle}"
                              Checked="AutoStartSidebar_Changed" Unchecked="AutoStartSidebar_Changed"
                              Margin="12,3,12,3" Padding="14,10"/>
                </StackPanel>

                
                <Button Grid.Row="2" Content="🚪 Выйти" Command="{Binding LogoutCommand}"
                        Style="{StaticResource SidebarButtonStyle}" Margin="14,0,14,14" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        
        <Grid Grid.Column="1" Margin="24,12,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            
            <Grid Grid.Row="0" Margin="0,4,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Привет, " Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="{Binding CurrentUser.Username}" Style="{StaticResource PageTitleStyle}"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="!" Style="{StaticResource PageTitleStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Экспорт JSON ⤓" Command="{Binding ExportToJsonCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Импорт JSON ⤒" Command="{Binding ImportFromJsonCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>

            
            <Border x:Name="ToolbarBorder" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="14">
                <DockPanel LastChildFill="True">
                    <Button x:Name="ClearSearchButton" DockPanel.Dock="Right" Content="Сбросить" Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border x:Name="SearchTextBoxHost" Background="{DynamicResource SoftBeigeBrush}" CornerRadius="10">
                        <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WatermarkTextBoxStyle}" Tag="  🔍  Поиск по названию..."
                                 Background="Transparent" BorderThickness="0" VerticalAlignment="Center" KeyDown="SearchTextBox_KeyDown"/>
                    </Border>
                </DockPanel>
            </Border>

            
            <Grid x:Name="OverviewPage" Grid.Row="2" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Обзор" Style="{StaticResource SectionTitleStyle}"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Всего задач" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Tasks.Count}" Style="{StaticResource PageTitleStyle}"
                                           FontSize="34" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Выполнено задач" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding CompletedTasksCount}" Style="{StaticResource PageTitleStyle}"
                                           FontSize="34" Foreground="{DynamicResource SecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="10,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Событий" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Events.Count}" Style="{StaticResource PageTitleStyle}"
                                           FontSize="34" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="10,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Заметок" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Notes.Count}" Style="{StaticResource PageTitleStyle}"
                                           FontSize="34" Foreground="#C9A27E"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="Ближайшие события" Style="{StaticResource SectionTitleStyle}" Margin="0,0,16,0"/>
                            </StackPanel>
                            <ListView Grid.Row="1" ItemsSource="{Binding Events}" Style="{StaticResource BaseListViewStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource SecondaryBrush}"
                                                        CornerRadius="14,0,0,14"/>
                                                <StackPanel Grid.Column="1" Margin="16,12,16,12">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="8"
                                                                Padding="8,3" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="🕰 " Style="{StaticResource MutedTextBlockStyle}"/>
                                                                <TextBlock Text="{Binding StartDate, StringFormat='dd.MM HH:mm'}"
                                                                           Style="{StaticResource MutedTextBlockStyle}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="8"
                                                                Padding="8,3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="📍 " Style="{StaticResource MutedTextBlockStyle}"/>
                                                                <TextBlock Text="{Binding Location}" Style="{StaticResource MutedTextBlockStyle}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            
            <Grid x:Name="TasksPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
                    <Button Content="+ Новая задача" Command="{Binding AddTaskCommand}"
                            Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Изменить" Command="{Binding EditTaskCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Удалить" Command="{Binding DeleteTaskCommand}" CommandParameter="{Binding SelectedItems, ElementName=TasksList}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="✔ Выполнено" Command="{Binding CompleteTaskCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>

                <ListView Grid.Row="1" x:Name="TasksList" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                          SelectionMode="Extended" Style="{StaticResource BaseListViewStyle}" MouseDoubleClick="TasksList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0"
                                    Opacity="{Binding IsCompleted, Converter={StaticResource BooleanToOpacityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}"
                                            CornerRadius="14,0,0,14"/>
                                    <StackPanel Grid.Column="1" Margin="16,12,16,12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}"
                                                       TextDecorations="{Binding IsCompleted, Converter={StaticResource BooleanToTextDecorationConverter}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource BaseTextBlockStyle}"
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="8"
                                                    Padding="8,3" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📅 " Style="{StaticResource MutedTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding DueDate, StringFormat=dd.MM.yyyy}"
                                                               Style="{StaticResource MutedTextBlockStyle}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="8"
                                                    Padding="8,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⚡ " Style="{StaticResource MutedTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding Priority}" Style="{StaticResource MutedTextBlockStyle}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="8"
                                                    Padding="8,3" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding IsCompleted, Converter={StaticResource BooleanToStatusBadgeConverter}}"
                                                           Style="{StaticResource MutedTextBlockStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            
            <Grid x:Name="EventsPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
                    <Button Content="+ Новое событие" Command="{Binding AddEventCommand}"
                            Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Изменить" Command="{Binding EditEventCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Удалить" Command="{Binding DeleteEventCommand}" CommandParameter="{Binding SelectedItems, ElementName=EventsList}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="✔ Завершить" Command="{Binding CompleteEventCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>

                <ListView Grid.Row="1" x:Name="EventsList" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                          SelectionMode="Extended" Style="{StaticResource BaseListViewStyle}" MouseDoubleClick="EventsList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0"
                                    Opacity="{Binding IsCompleted, Converter={StaticResource BooleanToOpacityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource SecondaryBrush}"
                                            CornerRadius="14,0,0,14"/>
                                    <StackPanel Grid.Column="1" Margin="16,12,16,12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}"
                                                       TextDecorations="{Binding IsCompleted, Converter={StaticResource BooleanToTextDecorationConverter}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource BaseTextBlockStyle}"
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="8"
                                                    Padding="8,3" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🕰 " Style="{StaticResource MutedTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding StartDate, StringFormat='dd.MM HH:mm'}"
                                                               Style="{StaticResource MutedTextBlockStyle}"/>
                                                    <TextBlock Text=" — " Style="{StaticResource MutedTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding EndDate, StringFormat='dd.MM HH:mm'}"
                                                               Style="{StaticResource MutedTextBlockStyle}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="8"
                                                    Padding="8,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📍 " Style="{StaticResource MutedTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding Location}" Style="{StaticResource MutedTextBlockStyle}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="8"
                                                    Padding="8,3" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding IsCompleted, Converter={StaticResource BooleanToStatusBadgeConverter}}"
                                                           Style="{StaticResource MutedTextBlockStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            
            <Grid x:Name="NotesPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
                    <Button Content="+ Новая заметка" Command="{Binding AddNoteCommand}"
                            Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Изменить" Command="{Binding EditNoteCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Удалить" Command="{Binding DeleteNoteCommand}" CommandParameter="{Binding SelectedItems, ElementName=NotesList}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>

                <ListView Grid.Row="1" x:Name="NotesList" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}"
                          SelectionMode="Extended" Style="{StaticResource BaseListViewStyle}" MouseDoubleClick="NotesList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#C9A27E" CornerRadius="14,0,0,14"/>
                                    <StackPanel Grid.Column="1" Margin="16,12,16,12">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="{Binding Content}" Style="{StaticResource BaseTextBlockStyle}"
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="✍ Создано: " Style="{StaticResource MutedTextBlockStyle}"/>
                                            <TextBlock Text="{Binding CreatedDate, StringFormat='dd.MM.yyyy HH:mm'}"
                                                       Style="{StaticResource MutedTextBlockStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            
            <Grid x:Name="AdminPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,14">
                    <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥 Пользователей: " Style="{StaticResource BaseTextBlockStyle}"/>
                            <TextBlock Text="{Binding TotalUsers}" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 Задач: " Style="{StaticResource BaseTextBlockStyle}"/>
                            <TextBlock Text="{Binding TotalTasks}" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅 Событий: " Style="{StaticResource BaseTextBlockStyle}"/>
                            <TextBlock Text="{Binding TotalEvents}" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝 Заметок: " Style="{StaticResource BaseTextBlockStyle}"/>
                            <TextBlock Text="{Binding TotalNotes}" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔 Напоминаний: " Style="{StaticResource BaseTextBlockStyle}"/>
                            <TextBlock Text="{Binding TotalReminders}" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
                    <Button Content="🔑 Сбросить пароль" Command="{Binding ResetUserPasswordCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="🗑 Удалить пользователя" Command="{Binding DeleteUserCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>

                <ListView Grid.Row="2" x:Name="AdminUsersList" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedAdminUser}"
                          SelectionMode="Single" Style="{StaticResource BaseListViewStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#C9A27E" CornerRadius="14,0,0,14"/>
                                    <StackPanel Grid.Column="1" Margin="16,12,16,12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Username}" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text=" 👤" Style="{StaticResource MutedTextBlockStyle}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="✉ " Style="{StaticResource MutedTextBlockStyle}"/>
                                            <TextBlock Text="{Binding Email}" Style="{StaticResource MutedTextBlockStyle}" Margin="2,0,12,0"/>
                                            <TextBlock Text="Registration: " Style="{StaticResource MutedTextBlockStyle}"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" Style="{StaticResource MutedTextBlockStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="CalendarPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,10,16,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12" Width="400">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Календарь" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <Calendar Grid.Row="1" x:Name="MainCalendar" Width="360" Height="230"
                                      HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12"
                                      SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                      Background="{DynamicResource LightCardBrush}"
                                      BorderBrush="Transparent" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Все события на выбранный день" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <ListView Grid.Row="1" x:Name="DayEventsList" Style="{StaticResource BaseListViewStyle}"
                                      MouseDoubleClick="DayItem_MouseDoubleClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🕐" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding StartDate, StringFormat='HH:mm'}" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource BaseTextBlockStyle}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,10,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding SelectedDate, StringFormat='dddd, dd MMMM yyyy'}"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>

                        <ListView Grid.Row="1" x:Name="DayTasksList" Style="{StaticResource BaseListViewStyle}"
                                  MouseDoubleClick="DayItem_MouseDoubleClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DueDate, StringFormat='HH:mm'}" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource BaseTextBlockStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
