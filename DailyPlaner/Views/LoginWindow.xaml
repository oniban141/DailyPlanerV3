<Page x:Class="DailyPlaner.Views.LoginWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DailyPlaner.Views"
      xmlns:viewModels="clr-namespace:DailyPlaner.ViewModels" d:DataContext="{d:DesignInstance Type=viewModels:LoginViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="Окно входа">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DailyPlaner;component/Resourse/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{DynamicResource LightBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Левая панель (серо-синяя, как сайдбар референса) ============ -->
        <Border Grid.Column="0" Background="{DynamicResource SecondaryBrush}" CornerRadius="0,28,28,0">
            <StackPanel VerticalAlignment="Center" Margin="48,40">
                <!-- Логотип -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,48">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="Д" Foreground="#FFFFFF" FontFamily="Segoe UI" FontSize="22"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Ежедневник" Foreground="#FFFFFF" FontFamily="Segoe UI"
                               FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock Text="Планируй свой день," Foreground="#FFFFFF" FontFamily="Segoe UI"
                           FontSize="30" FontWeight="Bold" TextWrapping="Wrap" LineHeight="38"/>
                <TextBlock Text="а мы всё запомним." Foreground="{StaticResource PrimaryBrush}"
                           FontFamily="Segoe UI" FontSize="30" FontWeight="Bold" Margin="0,0,0,24"/>

                <TextBlock Text="Задачи, события и заметки — всё в одном месте. Никаких лишних графиков, только то, что важно."
                           Foreground="#D4DCE8" FontFamily="Segoe UI" FontSize="14"
                           TextWrapping="Wrap" LineHeight="24" Margin="0,0,24,0"/>
            </StackPanel>
        </Border>

        <!-- ============ Правая часть — форма входа ============ -->
        <Grid Grid.Column="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">
                <TextBlock Text="С возвращением! 👋" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,6"/>
                <TextBlock Text="Войдите, чтобы продолжить" Style="{StaticResource MutedTextBlockStyle}" Margin="0,0,0,32"/>

                <TextBlock Text="Имя пользователя" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Margin="2,0,0,6"/>
                <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="10" Margin="0,0,0,16">
                    <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource WatermarkTextBoxStyle}" Tag="Введите имя пользователя"/>
                </Border>

                <TextBlock Text="Пароль" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" Margin="2,0,0,6"/>
                <Border Background="{DynamicResource SoftBeigeBrush}" CornerRadius="10" Margin="0,0,0,24">
                    <Grid>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource BasePasswordBoxStyle}"
                                    PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBlock x:Name="PasswordWatermark" Text="Введите пароль"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Button Content="Войти" Command="{Binding LoginCommand}"
                        Style="{StaticResource BaseButtonStyle}" FontSize="15" Padding="0,12" Margin="0,0,0,18"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Нет аккаунта?" Style="{StaticResource BaseTextBlockStyle}"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/>
                </StackPanel>

                <ProgressBar IsIndeterminate="{Binding IsLoading}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                             Height="4" Margin="0,24,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>