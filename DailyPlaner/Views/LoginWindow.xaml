<Page x:Class="DailyPlaner.Views.LoginWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DailyPlaner.Views"
      xmlns:viewModels="clr-namespace:DailyPlaner.ViewModels" d:DataContext="{d:DesignInstance Type=viewModels:LoginViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginWindow">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DailyPlaner;component/Resourse/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{StaticResource LightBackgroundBrush}">
        <Border Style="{StaticResource CardStyle}" Margin="100" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Daily Planner" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,15" Padding="5">
                    <TextBox Text="{Binding Username, Mode=TwoWay}" Style="{StaticResource BaseTextBoxStyle}">
                        <TextBox.Background>
                            <SolidColorBrush Color="Transparent"/>
                        </TextBox.Background>
                    </TextBox>
                </Border>
                
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,15" Padding="5">
                    <PasswordBox Password="{Binding Password, Mode=TwoWay}" Style="{StaticResource BaseTextBoxStyle}">
                        <PasswordBox.Background>
                            <SolidColorBrush Color="Transparent"/>
                        </PasswordBox.Background>
                    </PasswordBox>
                </Border>
                
                <Button Grid.Row="3" Content="Login" Command="{Binding LoginCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,0,15"/>
                
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Don't have an account?" Style="{StaticResource BaseTextBlockStyle}" VerticalAlignment="Center"/>
                    <Button Content="Register" Command="{Binding RegisterCommand}" Style="{StaticResource BaseButtonStyle}" Margin="10,0,0,0"/>
                </StackPanel>
                
                <ProgressBar Grid.Row="5" IsIndeterminate="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Height="4" Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Page>
